FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt-get/lists/*

# Создаем изолированный venv и прописываем его в PATH
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Собираем LD_PRELOAD-перехватчик файлового доступа (filegate.so).
# В runtime от gcc ничего не нужно — только готовая библиотека.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*
COPY presidio-litellm/filegate.c /build/filegate.c
RUN gcc -shared -fPIC -O2 -o /usr/local/lib/filegate.so /build/filegate.c -ldl && rm -rf /build

# Устанавливаем Hermes Agent напрямую из PyPI
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir hermes-agent

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]